# Copy this file to .env and fill it in. .env is git-ignored.

# Google Maps Platform API key with these APIs enabled:
#   - Maps JavaScript API   (Street View and maps in the browser)
#   - Street View Static API (free metadata lookups from the server)
GOOGLE_MAPS_API_KEY=

# Optional: your own Map ID (Cloud console -> Map management). Defaults to
# Google's DEMO_MAP_ID, which is fine for testing.
# GOOGLE_MAPS_MAP_ID=

# Optional for the local demo:
# DJANGO_SECRET_KEY=change-me
# DJANGO_DEBUG=1
